# Copie este arquivo para "backend/.env" e preencha com os seus valores.
# O .env não vai para o git (está no .gitignore).

# Senha do usuário root do MySQL
DB_PASSWORD=COLOQUE_SUA_SENHA_AQUI

# Chave que assina a sessão do login. Gere uma com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=COLOQUE_UMA_CHAVE_ALEATORIA_AQUI

# Opcional: modelo e endereço do Ollama usado no chat (padrões abaixo)
# OLLAMA_MODEL=llama3.2
# OLLAMA_URL=http://localhost:11434

# Chat com IA na nuvem (recomendado: rápido e mais preciso).
# Crie uma chave grátis em https://console.groq.com/keys
# Sem a chave, o chat usa o Ollama instalado no computador.
GROQ_API_KEY=
# Opcional: modelo da Groq (padrão: openai/gpt-oss-120b)
# GROQ_MODEL=openai/gpt-oss-120b

# Recuperação de senha: e-mail que envia os códigos.
# Com Gmail, use uma "senha de app" (https://myaccount.google.com/apppasswords), não a senha normal.
SMTP_USUARIO=
SMTP_SENHA=
# Opcional (padrão: Gmail)
# SMTP_SERVIDOR=smtp.gmail.com
# SMTP_PORTA=587

# Login com Google: crie um "ID do cliente OAuth" em https://console.cloud.google.com/apis/credentials
# URIs de redirecionamento autorizados:
#   http://localhost:5000/login/google/callback
#   http://127.0.0.1:5000/login/google/callback
# Se abrir o site por um link público (ex.: Cloudflare Tunnel), cadastre também
#   https://SEU-LINK/login/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Opcional: modo de depuração do Flask (recarrega o servidor ao salvar arquivos).
# Use só no seu computador. NUNCA ligue com o site aberto por link público.
# FLASK_DEBUG=1
